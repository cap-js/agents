{
  "name": "telemetry-v1-test",
  "version": "1.0.0",
  "type": "module",
  "description": "Test project for @cap-js/telemetry v1 (OTEL SDK v1) backward compatibility",
  "dependencies": {
    "@cap-js/agents": "file:../../../.",
    "@cap-js/telemetry": "^1",
    "@sap/cds": ">=8"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=1"
  },
  "cds": {
    "requires": {
      "telemetry": {
        "kind": "telemetry-to-console",
        "tracing": {
          "exporter": {
            "module": "@cap-js/telemetry",
            "class": "ConsoleSpanExporter"
          }
        },
        "metrics": {
          "exporter": {
            "module": "@cap-js/telemetry",
            "class": "ConsoleMetricExporter"
          }
        }
      }
    }
  }
}
