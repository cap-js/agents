{
  "name": "node-bookshop",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js CAP bookshop — main app for sidecar test",
  "scripts": {
    "start": "cds-serve"
  },
  "dependencies": {
    "@cap-js/hana": "^3.1.2",
    "@sap/cds": "^10.2.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=1"
  },
  "cds": {
    "protocols": {
      "hcql": {
        "path": "/hcql"
      }
    },
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      }
    }
  }
}
