  "type": "module",
  "description": "Test project for debug tracing, failing graph, and trace_langchain=false",
  "dependencies": {
    "@cap-js/agent": "file:../../../.",
    "@cap-js/telemetry": "^1",
    "@sap/cds": "^9"
  },
