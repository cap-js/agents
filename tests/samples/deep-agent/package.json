{
  "name": "agent-test-deep-agent-sample",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@cap-js/agents": "file:../../../",
    "@cap-js/audit-logging": ">=1",
    "@cap-js/sqlite": "*",
    "@cap-js/telemetry": "^1",
    "@langchain/core": "^1",
    "@langchain/langgraph": "^1",
    "@sap-ai-sdk/langchain": "^2",
    "deepagents": "^1.9.0",
    "zod": "^4"
  },
  "cds": {
    "requires": {
      "audit-log": false,
      "telemetry": {
        "tracing": false,
        "metrics": false
      },
      "[test]": {
        "audit-log": {
          "kind": "audit-log-to-console",
          "outbox": false
        },
        "telemetry": {
          "kind": "telemetry-to-console",
          "metrics": {
            "exporter": {
              "module": "@cap-js/telemetry",
              "class": "ConsoleMetricExporter"
            }
          }
        }
      },
      "[tracing]": {
        "audit-log": {
          "kind": "audit-log-to-console",
          "outbox": false
        },
        "telemetry": {
          "kind": "telemetry-to-console",
          "metrics": {
            "exporter": {
              "module": "@cap-js/telemetry",
              "class": "ConsoleMetricExporter"
            }
          }
        }
      }
    }
  }
}
