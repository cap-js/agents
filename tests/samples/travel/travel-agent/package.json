{
  "name": "agent-sample-travel-agent",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@cap-js/agents": "file:../../../..",
    "@cap-js/sqlite": "*",
    "@a2a-js/sdk": "^0.3.12",
    "@langchain/core": "^1",
    "@langchain/langgraph": "^1",
    "@langchain/mcp-adapters": "*",
    "deepagents": "^1.9.0",
    "zod": "^4"
  },
  "cds": {
    "agents": {
      "pool": {
        "maxLLMInvocationsPerTask": 50
      },
      "fileIO": {
        "enabled": true,
        "defaultInputModes": [
          "text/csv"
        ],
        "defaultOutputModes": [
          "text/plain",
          "text/markdown"
        ]
      }
    },
    "server": {
      "port": 4004
    },
    "requires": {
      "audit-log": false
    }
  }
}
