{
  "name": "CatalogService",
  "description": "Browse and order books from the catalog",
  "version": "1.0.0",
  "protocolVersion": "0.3.0",
  "preferredTransport": "JSONRPC",
  "additionalInterfaces": [
    {
      "transport": "JSONRPC"
    }
  ],
  "capabilities": {
    "streaming": true,
    "pushNotifications": true
  },
  "defaultInputModes": [
    "text/plain",
    "text/csv",
    "application/json",
    "application/pdf",
    "image/png",
    "image/jpeg"
  ],
  "defaultOutputModes": [
    "text/plain",
    "text/csv",
    "application/json",
    "application/pdf",
    "image/png",
    "image/jpeg"
  ],
  "skills": [
    {
      "id": "query",
      "name": "Data Query",
      "description": "Query data from the service. Available entities: \n Books: Book details with author information \n ListOfBooks: Browse available books \n Authors: Pseudonymized authors of the books on offer",
      "examples": [
        "Show me all Books"
      ],
      "tags": [
        "query",
        "data",
        "read",
        "books",
        "listofbooks",
        "authors"
      ]
    },
    {
      "id": "submitOrder",
      "name": "submitOrder",
      "description": "Submit an order for a book",
      "examples": [
        "Order 2 copies of Wuthering Heights"
      ],
      "tags": [
        "submitorder",
        "action",
        "hitl"
      ]
    },
    {
      "id": "getStock",
      "name": "getStock",
      "description": "Get stock level for a specific book",
