{
  "name": "@cap-js/agents",
  "version": "0.9.1",
  "description": "CDS plugin for building agents",
  "author": "SAP SE (https://www.sap.com)",
  "license": "Apache-2.0",
  "homepage": "https://cap.cloud.sap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cap-js/agents.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "npx eslint .",
    "test": "cds-test",
    "test:hybrid": "CDS_ENV=hybrid,tracing cds bind --exec -- cds-test",
    "test:mtx": "cds-test tests/integration/mtx.test.js",
    "watch:sample": "cds w tests/projects/bookshop",
    "watch:hybrid": "cds bind --exec -- npm run watch:sample",
    "watch:with-claude": "npm run watch:sample -- --profile with-claude",
    "watch:deep-agent": "cds w tests/projects/deep-agent --profile hybrid"
  },
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./index.cds": "./index.cds",
    "./cds-plugin": "./cds-plugin.js",
    "./package.json": "./package.json",
    "./lib/*": "./lib/*"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.cds",
    "lib",
    "srv",
    "cds-plugin.js",
    "_i18n"
  ],
  "dependencies": {
    "@sap-ai-sdk/orchestration": "^2.11.0",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "marked": "^18"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@sap/cds-mtxs": "^4",
    "@toon-format/toon": ">=2.3",
    "deepagents": "^1.10.2"
  },
  "peerDependencies": {
    "@cap-js/audit-logging": ">=1",
    "@cap-js/telemetry": ">=1",
    "@sap/cds": ">=9"
  },
  "peerDependenciesMeta": {
    "@cap-js/telemetry": {
      "optional": true
    },
    "@cap-js/audit-logging": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "cds": {
    "agents": {
      "streaming": true,
      "mlflow": false,
      "connect": "auto",
      "[development]": {
        "pushNotifications": {
          "allowedDomains": [
            "127.0.0.1",
            "localhost",
            "cloud.sap"
          ]
        }
      },
      "[hybrid]": {
        "pushNotifications": {
          "allowedDomains": [
            "127.0.0.1",
            "localhost",
            "cloud.sap"
          ]
        }
      },
      "pushNotifications": {
        "allowedDomains": [
          "cloud.sap"
        ]
      },
      "persistAllCheckpointWrites": false,
      "activeUsersInterval": "24h",
      "params": {
        "max_tokens": 4096,
        "temperature": 0
      },
      "contentFilter": true,
      "fileIO": {
        "enabled": false,
        "maxInputFileSizeBytes": 2097152,
        "maxOutputFileSizeBytes": 10485760,
        "defaultInputModes": [
          "text/csv",
          "application/json",
          "text/plain",
          "application/pdf",
          "image/png",
          "image/jpeg"
        ],
        "defaultOutputModes": [
          "text/csv",
          "application/json",
          "text/plain",
          "application/pdf",
          "image/png",
          "image/jpeg"
        ]
      }
    },
    "requires": {
      "agents": "agents",
      "kinds": {
        "agents": {
          "impl": "@cap-js/agents/lib/agentService.js",
          "model": "@cap-js/agents/index.cds"
        },
        "aicore": {
          "impl": "@cap-js/agents/lib/llm/aicore.js",
          "model": "anthropic--claude-opus-5",
          "contentFilter": true
        },
        "anthropic": {
          "impl": "@cap-js/agents/lib/llm/anthropic.js"
        },
        "openai": {
          "impl": "@cap-js/agents/lib/llm/openai.js"
        },
        "mock": {
          "impl": "@cap-js/agents/lib/llm/mock.js"
        }
      },
      "[development]": {
        "llm": "mock"
      },
      "[with-claude]": {
        "llm": "anthropic"
      },
      "[hybrid]": {
        "llm": "aicore"
      },
      "[production]": {
        "llm": "aicore"
      }
    },
    "protocols": {
      "agent": {
        "path": "/a2a",
        "impl": "@cap-js/agents"
      }
    },
    "[agent-sidecar]": {
      "server": {
        "port": 4006
      },
      "[java]": {
        "agent": {
          "_javaHcqlCompat": true
        }
      }
    }
  },
  "workspaces": [
    "tests/projects/*",
    "tests/projects/mtx/mtx/sidecar/",
    "tests/projects/travel/*",
    "tests/java-bookshop/agent/sidecar",
    "tests/java-bookshop"
  ]
}