{
  "name": "@cap-js/a2a",
  "version": "0.1.0",
  "description": "CDS protocol adapter for the A2A (Agent-to-Agent) protocol",
  "license": "Apache-2.0",
  "homepage": "https://cap.cloud.sap/",
  "main": "index.js",
  "scripts": {
    "lint": "npx eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --silent --testPathIgnorePatterns=tests/mtx",
    "test:hybrid": "cds bind --exec -- node --experimental-vm-modules node_modules/jest/bin/jest.js --silent",
    "test:mtx": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/mtx/",
    "watch:sample": "cds w tests/bookshop",
    "watch:hybrid": "DEBUG=a2a cds bind --exec -- cds w tests/bookshop",
    "watch:deepagent-sample": "cds w tests/deep-agent-sample",
    "prettier": "npx -y prettier@3 --write .",
    "prettier:check": "npx -y prettier@3 --check ."
  },
  "files": [
    "index.js",
    "index.cds",
    "lib",
    "cds-plugin.js"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^0.3.12",
    "@cap-js/mcp": "^0.0.11",
    "@langchain/core": "^1",
    "@langchain/langgraph": "^1",
    "@sap-ai-sdk/langchain": "^2",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": ">=0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-mtxs": ">=2",
    "@toon-format/toon": ">=0",
    "jest": "^30.3.0"
  },
  "peerDependencies": {
    "@cap-js/audit-logging": ">=1",
    "@cap-js/telemetry": ">=1",
    "@sap/cds": ">=8",
    "express": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@cap-js/telemetry": {
      "optional": true
    },
    "@cap-js/audit-logging": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "cds": {
    "a2a": {
      "llm": "anthropic--claude-4.6-sonnet",
      "trace_langchain": true,
      "activeUsersInterval": "24h",
      "params": {
        "max_tokens": 4096,
        "temperature": 0
      },
      "pool": {
        "maxConcurrentTasks": 5,
        "maxConcurrentTasksPerUser": 2,
        "maxTasksPerHour": 100,
        "maxTasksPerHourPerUser": 20,
        "maxLLMTokensPerDay": 5000000,
        "maxToolCallsPerHour": 1000,
        "maxToolCallsPerTask": 50,
        "maxLLMInvocationsPerTask": 15,
        "maxLLMTokensPerTask": 200000,
        "maxLLMCallTimeoutMs": 30000,
        "maxExecutionTimeMsPerTask": 300000
      }
    },
    "requires": {
      "a2a": {
        "model": "@cap-js/a2a"
      },
      "kinds": {
        "a2a-executor-mock": {
          "impl": "@cap-js/a2a/lib/executor/mock"
        },
        "a2a-executor-langgraph": {
          "impl": "@cap-js/a2a/lib/executor/langgraph"
        }
      },
      "[development]": {
        "a2a-executor": {
          "kind": "a2a-executor-mock"
        }
      },
      "[hybrid]": {
        "a2a-executor": {
          "kind": "a2a-executor-langgraph"
        },
        "joule-cap-proxy": {
          "binding": {
            "type": "cf",
            "apiEndpoint": "https://api.cf.eu12.hana.ondemand.com",
            "org": "cdsruntime",
            "space": "playground-sirsimon",
            "instance": "joule-cap-proxy",
            "key": "joule-cap-proxy-key"
          },
          "vcap": {
            "name": "joule-cap-proxy"
          }
        }
      },
      "[production]": {
        "a2a-executor": {
          "kind": "a2a-executor-langgraph"
        }
      }
    }
  },
  "workspaces": [
    "tests/bookshop/",
    "tests/deep-agent-sample/",
    "tests/mtx/app/mtx/sidecar/",
    "tests/telemetry-debug/",
    "tests/travel-sample/travel-agent/",
    "tests/travel-sample/xflights/",
    "tests/travel-sample/leisure-services/"
  ]
}
