{
  "name": "@cap-js/a2a",
  "version": "0.1.0",
  "description": "CDS protocol adapter for the A2A (Agent-to-Agent) protocol",
  "license": "Apache-2.0",
  "homepage": "https://cap.cloud.sap/",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./cds-plugin": "./cds-plugin.js",
    "./index.cds": "./index.cds",
    "./lib/executor/mock": "./lib/executor/mock.js",
    "./lib/executor/langgraph": "./lib/executor/langgraph/index.js",
    "./lib/*": "./lib/*"
  },
  "main": "index.js",
  "scripts": {
    "lint": "npx eslint .",
    "test": "CDS_ENV=test node --test --test-force-exit tests/integration/*.test.js",
    "test:hybrid": "CDS_ENV=test,hybrid cds bind --exec -- node --test --test-force-exit --test-timeout=900000 tests/integration/*.test.js tests/hybrid/*.test.js",
    "test:mtx": "CDS_ENV=test node --test --test-force-exit tests/mtx/*.test.js",
    "watch:sample": "cds w tests/bookshop",
    "watch:hybrid": "DEBUG=a2a cds bind --exec -- cds w tests/bookshop",
    "watch:deepagent-sample": "cds w tests/deep-agent-sample",
    "prettier": "npx -y prettier@3 --write .",
    "prettier:check": "npx -y prettier@3 --check ."
  },
  "files": [
    "index.js",
    "index.cds",
    "lib",
    "cds-plugin.js"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^0.3.12",
    "@cap-js/mcp": "^1",
    "@langchain/core": "^1",
    "@langchain/langgraph": "^1",
    "@sap-ai-sdk/langchain": "^2",
    "@sap-ai-sdk/orchestration": "^2.11.0",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": ">=0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-mtxs": ">=2",
    "@toon-format/toon": ">=0"
  },
  "peerDependencies": {
    "@cap-js/audit-logging": ">=1",
    "@cap-js/telemetry": ">=1",
    "@sap/cds": ">=8",
    "express": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@cap-js/telemetry": {
      "optional": true
    },
    "@cap-js/audit-logging": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "cds": {
    "a2a": {
      "llm": "anthropic--claude-4.6-sonnet",
      "streaming": true,
      "trace_langchain": true,
      "persistAllCheckpointWrites": false,
      "activeUsersInterval": "24h",
      "params": {
        "max_tokens": 4096,
        "temperature": 0
      },
      "contentFilter": true,
      "pool": {
        "maxConcurrentTasks": 10,
        "maxConcurrentTasksPerUser": 4,
        "maxTasksPerHour": 100,
        "maxTasksPerHourPerUser": 20,
        "maxLLMTokensPerDay": 5000000,
        "maxToolCallsPerHour": 1000,
        "maxToolCallsPerTask": 50,
        "maxLLMInvocationsPerTask": 15,
        "maxLLMTokensPerTask": 200000,
        "maxLLMCallTimeoutMs": 30000,
        "maxExecutionTimeMsPerTask": 300000,
        "maxIncomingMessageLength": 5000
      }
    },
    "requires": {
      "a2a": {
        "model": "@cap-js/a2a"
      },
      "kinds": {
        "a2a-executor-mock": {
          "impl": "@cap-js/a2a/lib/executor/mock"
        },
        "a2a-executor-langgraph": {
          "impl": "@cap-js/a2a/lib/executor/langgraph"
        }
      },
      "[development]": {
        "a2a-executor": {
          "kind": "a2a-executor-mock"
        }
      },
      "[hybrid]": {
        "a2a-executor": {
          "kind": "a2a-executor-langgraph"
        }
      },
      "[production]": {
        "a2a-executor": {
          "kind": "a2a-executor-langgraph"
        }
      }
    }
  },
  "workspaces": [
    "tests/bookshop/",
    "tests/deep-agent-sample/",
    "tests/mtx/app/mtx/sidecar/",
    "tests/telemetry-debug/",
    "tests/travel-sample/travel-agent/",
    "tests/travel-sample/xflights/",
    "tests/travel-sample/leisure-services/"
  ]
}
