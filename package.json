{
  "name": "@cap-js/agents",
  "version": "0.1.0",
  "description": "CDS plugin for building agents",
  "author": "SAP SE (https://www.sap.com)",
  "license": "Apache-2.0",
  "homepage": "https://cap.cloud.sap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cap-js/agents.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cds-plugin": "./cds-plugin.js",
    "./index.cds": "./index.cds",
    "./lib/models/*": "./lib/models/*.js",
    "./srv/langgraph-executor-srv": "./srv/langgraph-executor-srv.js",
    "./srv/*": "./srv/*",
    "./lib/*": "./lib/*"
  },
  "main": "index.js",
  "scripts": {
    "lint": "npx eslint .",
    "test": "CDS_ENV=test npx vitest run --config vitest.config.js",
    "test:cds8": "CDS_ENV=test npx vitest run --config vitest.config.js",
    "pretest:cds8": "npm pkg set 'overrides.@sap/cds=^8' 'overrides.@cap-js/sqlite=^1' 'overrides.@cap-js/hana=^1' 'overrides.@sap/cds-mtxs=^2' 'overrides.express=^4' && npm pkg set 'devDependencies.@sap/cds=^8' 'devDependencies.@cap-js/sqlite=^1' 'devDependencies.@cap-js/cds-test=>0' 'peerDependencies.@sap/cds=^8' && npm pkg delete 'devDependencies.@cap-js/hana' 'devDependencies.@sap/cds-mtxs' && rm -rf node_modules && npm i --legacy-peer-deps",
    "posttest:cds8": "git checkout package.json && rm -rf node_modules && npm i --legacy-peer-deps",
    "test:hybrid": "CDS_ENV=test,hybrid,tracing cds bind --exec -- npx vitest run --config vitest.config.hybrid.js",
    "test:mtx": "CDS_ENV=test npx vitest run --config vitest.config.js tests/integration/mtx.test.js",
    "watch:sample": "cds w tests/samples/bookshop",
    "watch:hybrid": "DEBUG=agent cds bind --exec -- cds w tests/samples/bookshop",
    "watch:with-claude": "cds w tests/samples/bookshop --profile with-claude",
    "watch:deep-agent": "cds w tests/samples/deep-agent --profile hybrid",
    "prettier": "npx -y prettier@3 --write .",
    "prettier:check": "npx -y prettier@3 --check ."
  },
  "files": [
    "index.js",
    "index.cds",
    "lib",
    "srv",
    "cds-plugin.js",
    "_i18n"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^0.3.12",
    "@cap-js/attachments": "^3.12.2",
    "@cap-js/mcp": "^1.4",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1",
    "@langchain/langgraph": "^1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@sap-ai-sdk/langchain": "^2.13.0",
    "@sap-ai-sdk/orchestration": "^2.11.0",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "deepagents": "^1.10.0",
    "langchain": "^1.5.0",
    "marked": "^18",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@sap/cds-mtxs": "^4",
    "@toon-format/toon": ">=2.3",
    "deepagents": "^1.10.2"
  },
  "peerDependencies": {
    "@cap-js/audit-logging": ">=1",
    "@cap-js/telemetry": ">=1",
    "@sap/cds": ">=8"
  },
  "peerDependenciesMeta": {
    "@cap-js/telemetry": {
      "optional": true
    },
    "@cap-js/audit-logging": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "cds": {
    "agents": {
      "llm": "anthropic--claude-4.6-sonnet",
      "streaming": true,
      "trace_langchain": true,
      "mlflow": false,
      "connect": "auto",
      "[development]": {
        "pushNotifications": {
          "allowedDomains": [
            "127.0.0.1",
            "localhost",
            "cloud.sap"
          ]
        }
      },
      "[hybrid]": {
        "pushNotifications": {
          "allowedDomains": [
            "127.0.0.1",
            "localhost",
            "cloud.sap"
          ]
        }
      },
      "pushNotifications": {
        "allowedDomains": [
          "cloud.sap"
        ]
      },
      "persistAllCheckpointWrites": false,
      "activeUsersInterval": "24h",
      "params": {
        "max_tokens": 4096,
        "temperature": 0
      },
      "contentFilter": true,
      "fileIO": {
        "enabled": false,
        "maxOutputFileSizeBytes": 10485760,
        "defaultInputModes": [
          "text/csv",
          "application/json",
          "text/plain",
          "application/pdf",
          "image/png",
          "image/jpeg"
        ],
        "defaultOutputModes": [
          "text/csv",
          "application/json",
          "text/plain",
          "application/pdf",
          "image/png",
          "image/jpeg"
        ]
      },
      "pool": {
        "maxConcurrentTasks": 10,
        "maxConcurrentTasksPerUser": 4,
        "maxTasksPerHour": 100,
        "maxTasksPerHourPerUser": 20,
        "maxLLMTokensPerDay": 5000000,
        "maxToolCallsPerHour": 1000,
        "maxToolCallsPerTask": 50,
        "maxLLMInvocationsPerTask": 50,
        "maxLLMTokensPerTask": 200000,
        "maxLLMCallTimeout": "120s",
        "maxExecutionTimePerTask": "5min",
        "timeoutGrace": "15s",
        "maxIncomingMessageLength": 5000
      }
    },
    "requires": {
      "agents": {
        "model": "@cap-js/agents"
      },
      "agent-push-notifications": {
        "impl": "@cap-js/agents/srv/push-notification-srv.js"
      },
      "mlflow": {
        "vcap": {
          "label": "user-provided",
          "name": "mlflow"
        }
      },
      "kinds": {
        "llm-aicore": {
          "impl": "@cap-js/agents/lib/models/aicore",
          "model": "anthropic--claude-4.6-sonnet",
          "contentFilter": true
        },
        "llm-anthropic": {
          "impl": "@cap-js/agents/lib/models/anthropic"
        },
        "llm-mock": {
          "impl": "@cap-js/agents/lib/models/mock"
        }
      },
      "[development]": {
        "llm": "mock"
      },
      "[with-claude]": {
        "llm": "anthropic"
      },
      "[hybrid]": {
        "llm": "aicore"
      },
      "[production]": {
        "llm": "aicore"
      }
    },
    "protocols": {
      "agent": {
        "path": "/a2a",
        "impl": "@cap-js/agents/lib/index.cjs"
      }
    },
    "[agent-sidecar]": {
      "server": {
        "port": 4006
      },
      "[java]": {
        "agent": {
          "_javaHcqlCompat": true
        }
      }
    }
  },
  "workspaces": [
    "tests/samples/bookshop/",
    "tests/samples/deep-agent/",
    "tests/samples/mtx/mtx/sidecar/",
    "tests/samples/telemetry-debug/",
    "tests/samples/telemetry-v1/",
    "tests/samples/travel/travel-agent/",
    "tests/samples/travel/xflights/",
    "tests/samples/travel/leisure-services/",
    "tests/sidecar-samples/java-bookshop/agent/sidecar",
    "tests/sidecar-samples/java-bookshop",
    "tests/sidecar-samples/node-bookshop/agent/sidecar",
    "tests/sidecar-samples/node-bookshop"
  ]
}
