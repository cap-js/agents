{
  "name": "@cap-js/a2a",
  "version": "0.1.0",
  "description": "CDS protocol adapter for the A2A (Agent-to-Agent) protocol",
  "license": "Apache-2.0",
  "homepage": "https://cap.cloud.sap/",
  "main": "cds-plugin.js",
  "scripts": {
    "lint": "npx eslint .",
    "test": "npx jest --silent",
    "test:hybrid": "cds bind --exec -- npx jest",
    "watch:sample": "cds w tests/bookshop",
    "prettier": "npx -y prettier@3 --write .",
    "prettier:check": "npx -y prettier@3 --check .",
    "generate-sample-card": "cd tests/bookshop && cds c srv -s CatalogService -2 a2a > expected-agent-card.json",
    "pretest": "(command -v cds >/dev/null || npm i -g @sap/cds-dk) && npm run generate-sample-card"
  },
  "files": [
    "index.cds",
    "lib",
    "cds-plugin.js"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^0.3.12",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": ">=0",
    "@cap-js/sqlite": "^2"
  },
  "peerDependencies": {
    "@sap/cds": ">=8",
    "express": "^4 || ^5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "tests/bookshop/"
  ],
  "cds": {
    "requires": {
      "a2a": {
        "model": "@cap-js/a2a"
      },
      "kinds": {
        "a2a-executor-mock": {
          "impl": "@cap-js/a2a/lib/executor/mock"
        }
      },
      "[development]": {
        "a2a-executor": {
          "kind": "a2a-executor-mock"
        }
      }
    }
  }
}
